msgctxt "actor_descriptors_mmd"
msgid "+ Back Rank\n+ Positional Tokens\n+ Support\n+ Summoner"
msgstr "+ 후방\n+ 위치 토큰\n+ 지원\n+ 소환사"

msgctxt "actor_verbose_description_mmd"
msgid "“Defences crumble as the spores\nfill the air.”"
msgstr "“포자가 공기를 채우면\n방어는 무너진다.”"

msgctxt "bark_act_out_rest_item_hate_block+envious+mmd"
msgid "You clearly do not require my assistance."
msgstr "내 도움은 필요 없어 보이는군."

msgctxt "bark_act_out_rest_item_hate_block+hateful+mmd"
msgid "Bother someone else."
msgstr "딴 데 가서 귀찮게 해."

msgctxt "bark_act_out_rest_item_hate_block+resentful+mmd"
msgid "I don't need you."
msgstr "너 따윈 필요 없다."

msgctxt "bark_act_out_rest_item_hate_block+tumultuous+mmd"
msgid "The fiends outside are better company."
msgstr "차라리 밖에 있는 괴물들이 낫겠군."

msgctxt "bark_god_summon_failure+mmd"
msgid "I've seen such tricks before..."
msgstr "그런 수작은 전에도 봤다..."

msgctxt "bark_hero_failure_kill+mmd"
msgid "You'll fall like any other sick critter."
msgstr "너도 병든 짐승들처럼 쓰러질 거다."

msgctxt "bark_item_experimental_remedy+mmd"
msgid "Let's see..."
msgstr "어디 보자..."

msgctxt "bark_item_guided_meditation+mmd"
msgid "Let's see..."
msgstr "어디 보자..."

msgctxt "bark_item_improvised_strategy+mmd"
msgid "Let's see..."
msgstr "어디 보자..."

msgctxt "bark_item_mmd_penicillin"
msgid "I'll trust you, for now."
msgstr "일단은 믿어 보지."

msgctxt "bark_item_mmd_penicillin+bounty_hunter"
msgid "Long as it works..."
msgstr "일단 약효만 든다면야..."

msgctxt "bark_item_mmd_penicillin+flagellant"
msgid "Your medicine profanes my flesh."
msgstr "그대의 약은 내 육신을 모독하는군."

msgctxt "bark_item_mmd_penicillin+grave_robber"
msgid "I'd swear he enjoys subjecting us to this."
msgstr "저 녀석, 우리한테 이런 걸 먹이는 걸 즐기는 게 분명해."

msgctxt "bark_item_mmd_penicillin+hellion"
msgid "What foul spirits!"
msgstr "고약한 기운이로군!"

msgctxt "bark_item_mmd_penicillin+highwayman"
msgid "Pass it here. This journey's wearin' me down."
msgstr "이리 넘겨. 이 여정 때문에 몸이 남아나질 않아."

msgctxt "bark_item_mmd_penicillin+jester"
msgid "You're <i>hilarious</i>."
msgstr "이거 <i>진짜 웃기다</i>."

msgctxt "bark_item_mmd_penicillin+leper"
msgid "Perhaps wasted on one such as I..."
msgstr "나와 같은 자에게는 낭비가 아닐까 싶네만..."

msgctxt "bark_item_mmd_penicillin+man_at_arms"
msgid "Can't be choosy with field medicine."
msgstr "응급처치용인데 까탈스러울 필요는 없지."

msgctxt "bark_item_mmd_penicillin+mmd"
msgid "Take it or not. Your choice."
msgstr "먹든 말든 알아서 해."

msgctxt "bark_item_mmd_penicillin+occultist"
msgid "I dearly hope my sense of smell recovers."
msgstr "내 후각이 되돌아오기만을 바랄 뿐."

msgctxt "bark_item_mmd_penicillin+plague_doctor"
msgid "No, it hasn't gone off."
msgstr "아니, 상한 거 아니야."

msgctxt "bark_item_mmd_penicillin+runaway"
msgid "<i>Ugggghhh.</i>"
msgstr "<i>으우우웩.</i>"

msgctxt "bark_item_mmd_penicillin+vestal"
msgid "At least I can render my own aid if this backfires..."
msgstr "뭐, 이게 부작용이 나거든 내가 도울 수는 있겠지..."

msgctxt "bark_item_morbid_joke+mmd"
msgid "Let's see..."
msgstr "어디 보자..."

