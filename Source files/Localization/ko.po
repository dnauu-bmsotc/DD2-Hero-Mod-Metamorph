msgctxt "bark_node_exit_altarofhope+mmd"
msgid "..."
msgstr "..."

msgctxt "bark_node_exit_bridge+mmd"
msgid "We are on the right path."
msgstr "제대로 가고 있군."

msgctxt "bark_node_exit_bridgegang+mmd"
msgid "They're coming. Can feel it."
msgstr "놈들이 온다. 느껴져."

msgctxt "bark_node_exit_cache+mmd"
msgid "Grab the loot and let's go!"
msgstr "전리품 챙기고 가자!"

msgctxt "bark_node_exit_cachegang+mmd"
msgid "Can't remember the time I last slept a full night..."
msgstr "하룻밤 푹 잔 게 언제였는지 기억도 안 나네..."

msgctxt "bark_node_exit_failure_creatureden+mmd"
msgid "Stupid beasts!"
msgstr "멍청한 짐승들!"

msgctxt "bark_node_exit_failure_dungeon+mmd"
msgid "Retreat!"
msgstr "후퇴!"

msgctxt "bark_node_exit_failure_gauntchirurgeon+mmd"
msgid "Close one."
msgstr "아슬아슬했군."

msgctxt "bark_node_exit_failure_guardian+mmd"
msgid "No more!"
msgstr "이제 그만!"

msgctxt "bark_node_exit_failure_storycultist+mmd"
msgid "What's that ringing in my ears?!"
msgstr "귀에서 울리는 이 소리는 뭐지?!"

msgctxt "bark_node_exit_failure_storyhero+herostory_MMD_02"
msgid "I did naething wrong!"
msgstr "난 아무 짓도 안 했다고!"

msgctxt "bark_node_exit_failure_storyresist+mmd"
msgid "Retreat! "
msgstr "후퇴!"

msgctxt "bark_node_exit_gate+kingdominnsieged+mmd"
msgid "The kingdom is falling. Pathetic!"
msgstr "왕국이 무너지고 있군. 한심하다!"

msgctxt "bark_node_exit_gate+mmd"
msgid "We are on the right path."
msgstr "제대로 가고 있군."

msgctxt "bark_node_exit_heroselect+mmd"
msgid "..."
msgstr "..."

msgctxt "bark_node_exit_hospital+mmd"
msgid "Hurry up."
msgstr "서둘러."

msgctxt "bark_node_exit_oasis+mmd"
msgid "We don't have time to lounge around."
msgstr "늘어져 있을 시간 없다."

msgctxt "bark_node_exit_store+mmd"
msgid "We are ready."
msgstr "준비됐다."

msgctxt "bark_node_exit_storyassist+mmd"
msgid "On to the next!"
msgstr "계속 가자!"

msgctxt "bark_node_exit_storyassistgang+mmd"
msgid "We leave them and journey to the source of their pain..."
msgstr "저들을 남겨 두고, 고통의 근원을 향해 간다..."

msgctxt "bark_node_exit_storycosmic+mmd"
msgid "Let's get away from this place."
msgstr "이곳을 벗어나자."

msgctxt "bark_node_exit_success_creatureden+mmd"
msgid "Good riddance."
msgstr "꼴 좋다."

msgctxt "bark_node_exit_success_gauntchirurgeon+mmd"
msgid "Damn his tricks!"
msgstr "빌어먹을 놈의 수작!"

msgctxt "bark_node_exit_success_guardian+mmd"
msgid "We did it..."
msgstr "해냈군..."

msgctxt "bark_node_exit_success_storycultist+mmd"
msgid "That'll buy us a little time."
msgstr "이걸로 시간은 좀 벌었군."

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_01"
msgid "Had no time and no desire to listen."
msgstr "들을 시간도, 들을 마음도 없었다."

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_02"
msgid "My impatience almost killed me."
msgstr "조급함 때문에 죽을 뻔했지."

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_03"
msgid "I thought I’d won just by surviving."
msgstr "살아남은 것만으로 이긴 줄 알았다."

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_04"
msgid "I didn't want this. This shouldnae have happened!"
msgstr "이런 걸 원한 게 아니야. 이런 일은 일어나선 안 됐다고!"

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_05"
msgid "What I’ve become..."
msgstr "내가 이런 게 되다니..."

msgctxt "bark_node_exit_success_storyhero+herostory_MMD_06"
msgid "I am changing."
msgstr "나는 변하고 있다."

msgctxt "bark_node_exit_success_storyresist+mmd"
msgid "Well fought."
msgstr "잘 싸웠다."

msgctxt "bark_node_exit_watchtower+mmd"
msgid "Least we know what's coming."
msgstr "적어도 뭐가 오는지는 알겠군."

msgctxt "bark_route_combat+mmd"
msgid "There it is."
msgstr "저기 있군."

msgctxt "bark_route_hazard+mmd"
msgid "Get to cover!"
msgstr "엄폐해!"

msgctxt "bark_route_oblivion_tear+mmd"
msgid "GET OUT OF MY HEAD!"
msgstr "내 머리에서 나가!"

msgctxt "bark_route_rough_patch+mmd"
msgid "Hang tight!"
msgstr "꽉 잡아!"

msgctxt "bark_route_safe+mmd"
msgid "A moment of peace."
msgstr "잠깐의 평화로군."

